<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>CommonCrop: one common crop for all your integrated masters, on the area covered by every sub-frame.</p>
      <p>Add https://jps-34.github.io/CommonCrop/ under Resources &gt; Updates &gt; Manage Repositories.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.5:1.9.99">
      <package fileName="CommonCrop-1.1.8-PI195.zip" sha1="d375edb2b3c568c848bfc24019986fcc7b2814ae" type="script" releaseDate="20261126" serverURL="https://jps-34.github.io/CommonCrop/">
         <title>CommonCrop 1.1.8 (PixInsight 1.9.5 and later)</title>
         <description>
            <p>Crops a set of integrated masters (L, R, G, B, SII, Ha, OIII and two auxiliary channels) to the one rectangle covered by every sub-frame of every channel, from the masters alone. Reports a field-loss score per filter and checks the noise at the crop edges. Creates new images by default; an option crops the masters in place. English or French interface. Installs under Script &gt; JPS &gt; CommonCrop.</p>
            <p>Copyright (c) 2026 Jacques Pouyaud. GNU GPL v3 or later. Source: https://github.com/jps-34/CommonCrop</p>
         </description>
      </package>
   </platform>
</xri>
